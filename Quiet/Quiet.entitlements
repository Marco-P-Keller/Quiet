<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The one thing Quiet sends anywhere, and only when somebody switches it
	     on: the limit, the wait and today's total, in the reader's own iCloud,
	     so that a second device is not a second allowance.

	     The key-value store rather than CloudKit's database, because a CKRecord
	     needs a schema pushed to production by hand from a desktop browser
	     before a TestFlight build can write a single field — and until somebody
	     does that, the feature is silently dead with no way to tell from the
	     phone. See `CloudMirror`. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>

	<!-- Screen Time, for one person on their own phone, and only once they
	     have switched it on in Settings: the Instagram app is counted against
	     the same daily limit as Quiet and closed when it is spent. See
	     `InstagramAppLimit`. -->
	<key>com.apple.developer.family-controls</key>
	<true/>
	<!-- The shelf Quiet shares with its two Screen Time extensions. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.connexa.quiet</string>
	</array>
</dict>
</plist>
