<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Quiet does not track anyone, anywhere, by any definition. There are no
	     analytics, no advertising identifiers, and no network calls of Quiet's
	     own: the only traffic the app makes is Instagram's own site, loaded in
	     a web view under the reader's own session. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- ProcessInfo.systemUptime, in QuietSession. It is the clock the
			     whole limit rests on: elapsed foreground time measured against
			     something no settings screen can move. Apple counts it as a
			     boot-time API, and reason 35F9.1 is exactly this use —
			     measuring time between events inside the app. Without this
			     declaration App Store Connect rejects the upload outright
			     (ITMS-91053). -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
		<dict>
			<!-- UserDefaults, in Preferences, Applause, Remembered and
			     ThisPhone: the shape of the row, the daily reminder, how long
			     the app has been on screen, the glyphs the row was drawn with
			     last time, and the anonymous name this device writes its own
			     figures under when the limit is carried between devices. All of that is written
			     and read by this app alone, which is precisely reason CA92.1. The
			     one thing that has to outlive a reinstall, the limit, is not
			     here; it is in the keychain, which Apple does not count.

			     Reason 1C8F.1 is the app group Quiet shares with its own two
			     Screen Time extensions, and with nobody else: the limit and
			     today's minutes in Quiet, which the extension needs in order to
			     close the Instagram app at the right moment, and the minutes the
			     Instagram app has had, which it reports back. See `Shelf`.

			     This declaration was missing while the row preference shipped,
			     and it is the sort of omission that is invisible until an
			     upload comes back as ITMS-91053. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
