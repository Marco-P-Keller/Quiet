          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre ce profil"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre este perfil"
          }
        }
      }
    },
    "Quiet": {
      "localizations": {
