{
  "sourceLanguage": "en",
  "strings": {
    " You can ask for more again %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Um mehr kannst du wieder %@ bitten."
          }
        }
      }
    },
    " You have already used more than that today, so today ends here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Du hast heute schon mehr verbraucht, also endet der Tag hier."
          }
        }
      }
    },
    "%@ a day, starting %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ am Tag, ab %@."
          }
        }
      }
    },
    "%@ from %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ab %@."
          }
        }
      }
    },
    "%@ is not part of Instagram, so it opened in Safari. If you were signing in, come back and start again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gehört nicht zu Instagram und wurde deshalb in Safari geöffnet. Falls du dich gerade anmelden wolltest: komm zurück und fang noch einmal an."
          }
        }
      }
    },
    "%@ left today.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute noch %@."
          }
        }
      }
    },
    "%lld minutes": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "1 Minute"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Minuten"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "1 minute"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld minutes"
                }
              }
            }
          }
        }
      }
    },
    "%lld minutes left.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Noch eine Minute."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Noch %lld Minuten."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "One minute left."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld minutes left."
                }
              }
            }
          }
        }
      }
    },
    "A page at %@ was opened in Safari during a sign-in. If signing in did not work, that is the address to report.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Seite auf %@ wurde während einer Anmeldung in Safari geöffnet. Falls die Anmeldung nicht geklappt hat, ist das die Adresse, die man melden sollte."
          }
        }
      }
    },
    "Ask for %@ a day": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um %@ am Tag bitten"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück"
          }
        }
      }
    },
    "Bar": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leiste"
          }
        }
      }
    },
    "Cancels the increase you asked for.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt die Erhöhung zurück, um die du gebeten hast."
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter"
          }
        }
      }
    },
    "Daily limit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tageslimit"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        }
      }
    },
    "Explore is off in Quiet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore ist in Quiet aus."
          }
        }
      }
    },
    "Find someone": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemanden finden"
          }
        }
      }
    },
    "Home": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        }
      }
    },
    "How much Instagram\ndo you want in a day?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel Instagram\nwillst du am Tag?"
          }
        }
      }
    },
    "Instagram,\nminus the parts\nthat keep you there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Instagram,\nohne die Teile,\ndie dich festhalten."
          }
        }
      }
    },
    "Instagram, on your terms.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Instagram, zu deinen Bedingungen."
          }
        }
      }
    },
    "Island": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Insel"
          }
        }
      }
    },
    "Less takes effect at once. More starts the next day, and only once a week.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger gilt sofort. Mehr beginnt am nächsten Tag — und nur einmal pro Woche."
          }
        }
      }
    },
    "Looking…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche …"
          }
        }
      }
    },
    "Messages": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten"
          }
        }
      }
    },
    "Minutes a day": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuten am Tag"
          }
        }
      }
    },
    "No Reels. No Explore. No accounts suggested between your friends.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Reels. Kein Explore. Keine vorgeschlagenen Konten zwischen deinen Freunden."
          }
        }
      }
    },
    "No connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung."
          }
        }
      }
    },
    "No more doomscrolling.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schluss mit Doomscrolling."
          }
        }
      }
    },
    "No time left today.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute ist die Zeit vorbei."
          }
        }
      }
    },
    "Nobody by that name.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand mit diesem Namen."
          }
        }
      }
    },
    "Notifications": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen"
          }
        }
      }
    },
    "Opens this profile": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet dieses Profil"
          }
        }
      }
    },
    "Quiet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet"
          }
        }
      }
    },
    "Quiet cannot save to this phone's keychain. Your limit will not survive closing the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet kann nicht in den Schlüsselbund dieses Telefons schreiben. Dein Limit überlebt das Schließen der App nicht."
          }
        }
      }
    },
    "Quiet could not load %@ from its own bundle. This build is broken; reinstall it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet konnte %@ nicht aus dem eigenen Bundle laden. Dieser Build ist kaputt; installiere ihn neu."
          }
        }
      }
    },
    "Quiet has no account, no servers and no analytics. It stores four things on this phone: your limit, today's total, the last time it saw, and the day you set it up.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet hat kein Konto, keine Server und keine Analyse. Es speichert vier Dinge auf diesem Telefon: dein Limit, den heutigen Stand, den spätesten Zeitpunkt, den es gesehen hat, und den Tag, an dem du es eingerichtet hast."
          }
        }
      }
    },
    "Quiet has not been able to find Instagram's own layout on the last few pages. Instagram has probably changed something. Reels and Explore are still closed — those are refused by address — but the tidying up around them may not be.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet hat auf den letzten Seiten Instagrams eigenes Layout nicht gefunden. Wahrscheinlich hat Instagram etwas geändert. Reels und Explore bleiben zu — die werden nach Adresse abgewiesen — aber das Aufräumen drumherum vielleicht nicht."
          }
        }
      }
    },
    "Quiet is missing %@. Reinstall from a clean build.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet fehlt %@. Neu aus einem sauberen Build installieren."
          }
        }
      }
    },
    "Quiet is not affiliated with or endorsed by Instagram or Meta.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet steht in keiner Verbindung zu Instagram oder Meta und wird von ihnen nicht unterstützt."
          }
        }
      }
    },
    "Quiet is your Instagram here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet ist hier dein Instagram."
          }
        }
      }
    },
    "Quiet runs on Instagram's mobile site, so pages load a beat slower and a few things are missing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet läuft auf Instagrams mobiler Website. Seiten laden einen Takt langsamer, und ein paar Dinge fehlen."
          }
        }
      }
    },
    "Quiet settings": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet-Einstellungen"
          }
        }
      }
    },
    "Quiet works between %lld and %lld minutes a day.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet arbeitet zwischen %lld und %lld Minuten am Tag."
          }
        }
      }
    },
    "Quiet's second lock did not load this time. Reels and Explore are still refused; there is one layer doing it rather than two.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiets zweites Schloss ist diesmal nicht geladen. Reels und Explore werden weiterhin abgewiesen; es tut das gerade eine Ebene statt zwei."
          }
        }
      }
    },
    "Reels are off in Quiet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reels sind in Quiet aus."
          }
        }
      }
    },
    "Resets at %@. Only time with Instagram on screen counts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückgesetzt um %@. Es zählt nur Zeit, in der Instagram auf dem Bildschirm ist."
          }
        }
      }
    },
    "Search is not answering. An exact name still works: type it and press search.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche antwortet nicht. Ein genauer Name geht trotzdem: eintippen und auf Suchen drücken."
          }
        }
      }
    },
    "Set %@ a day": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ am Tag festlegen"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen"
          }
        }
      }
    },
    "Sign out": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abmelden"
          }
        }
      }
    },
    "Sign out of Instagram": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Instagram abmelden"
          }
        }
      }
    },
    "Sign out of Instagram?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Instagram abmelden?"
          }
        }
      }
    },
    "Starts %@. Today stays at %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnt %@. Heute bleibt bei %@."
          }
        }
      }
    },
    "Takes effect now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt ab sofort."
          }
        }
      }
    },
    "That doesn't look like a username.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nicht nach einem Benutzernamen aus."
          }
        }
      }
    },
    "That's all\nfor today.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das war's\nfür heute."
          }
        }
      }
    },
    "The bar is the shape Instagram uses. The island floats over the page, and draws itself in while the page is moving.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leiste ist die Form, die Instagram benutzt. Die Insel schwebt über der Seite und zieht sich zusammen, während die Seite in Bewegung ist."
          }
        }
      }
    },
    "The date on this phone is ahead of Instagram's, so Quiet is going by Instagram's. The limit can be lowered, but not raised, until the two agree.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Datum auf diesem Telefon geht Instagram voraus, also richtet Quiet sich nach Instagram. Das Limit kann gesenkt, aber nicht erhöht werden, bis beide übereinstimmen."
          }
        }
      }
    },
    "The date on this phone is ahead of Instagram's. Until the two agree, the limit can go down but not up.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Datum auf diesem Telefon geht Instagram voraus. Bis beide übereinstimmen, kann das Limit sinken, aber nicht steigen."
          }
        }
      }
    },
    "The date on this phone is behind where Quiet last saw it. The limit can be lowered, but not raised, until it catches up.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Datum auf diesem Telefon liegt hinter dem, was Quiet zuletzt gesehen hat. Das Limit kann gesenkt werden, aber nicht erhöht, bis es aufgeholt hat."
          }
        }
      }
    },
    "The date on this phone is behind where Quiet last saw it. Until it catches up, the limit can go down but not up.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Datum auf diesem Telefon liegt hinter dem, was Quiet zuletzt gesehen hat. Bis es aufgeholt hat, kann das Limit sinken, aber nicht steigen."
          }
        }
      }
    },
    "The row along the bottom": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Reihe am unteren Rand"
          }
        }
      }
    },
    "This clears the Instagram session from this app. Your daily limit stays as it is.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das löscht die Instagram-Sitzung aus dieser App. Dein Tageslimit bleibt, wie es ist."
          }
        }
      }
    },
    "This is your limit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist dein Limit."
          }
        }
      }
    },
    "This phone is refusing to let Quiet write anything down. Your limit will not survive closing the app until that changes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Telefon lässt Quiet nichts aufschreiben. Bis sich das ändert, überlebt dein Limit das Schließen der App nicht."
          }
        }
      }
    },
    "Type a name. Quiet searches for people and nothing else — no Explore, no hashtags, no places.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe einen Namen. Quiet sucht nach Menschen und sonst nichts — kein Explore, keine Hashtags, keine Orte."
          }
        }
      }
    },
    "Version %@ (%@)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ (%@)"
          }
        }
      }
    },
    "You asked for %@ a day. Quiet opens again at %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dir %@ am Tag vorgenommen. Quiet öffnet wieder um %@."
          }
        }
      }
    },
    "You can ask for less whenever you like. It takes effect at once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um weniger kannst du jederzeit bitten. Es gilt sofort."
          }
        }
      }
    },
    "You can ask for more once a week, and it starts the next day — never in the moment you want five more minutes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um mehr kannst du einmal pro Woche bitten, und es beginnt am nächsten Tag — nie in dem Moment, in dem du fünf Minuten mehr willst."
          }
        }
      }
    },
    "You raised your limit less than a week ago. You can ask for more again %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dein Limit vor weniger als einer Woche erhöht. Um mehr kannst du wieder %@ bitten."
          }
        }
      }
    },
    "You sign in on Instagram's own page. Your password never touches Quiet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du meldest dich auf Instagrams eigener Seite an. Dein Passwort berührt Quiet nie."
          }
        }
      }
    },
    "Your feed, your stories, your messages, your profile. Everything else works the way it always did.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Feed, deine Stories, deine Nachrichten, dein Profil. Alles andere funktioniert wie immer."
          }
        }
      }
    },
    "Your limit is kept in the keychain, which outlives the app. Deleting Quiet and installing it again does not reset it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Limit liegt im Schlüsselbund, der die App überlebt. Quiet zu löschen und neu zu installieren setzt es nicht zurück."
          }
        }
      }
    },
    "Your limit is kept outside the app. Deleting Quiet and installing it again does not reset it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Limit liegt außerhalb der App. Quiet zu löschen und neu zu installieren setzt es nicht zurück."
          }
        }
      }
    },
    "Your limit is now %@ a day.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Limit ist jetzt %@ am Tag."
          }
        }
      }
    },
    "Your profile": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Profil"
          }
        }
      }
    },
    "Your time today, your daily limit, and finding someone": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Zeit heute, dein Tageslimit und jemanden finden"
          }
        }
      }
    },
    "name": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "name"
          }
        }
      }
    },
    "on %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "am %@"
          }
        }
      }
    },
    "today": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "heute"
          }
        }
      }
    },
    "tomorrow": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "morgen"
          }
        }
      }
    }
  },
  "version": "1.0"
}
