    "Quiet runs on Instagram's mobile site, so pages load a beat slower and a few things are missing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet läuft auf Instagrams mobiler Website. Seiten laden einen Takt langsamer, und ein paar Dinge fehlen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet runs on Instagram's mobile site, so pages load a beat slower and a few things are missing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet funciona sobre el sitio móvil de Instagram, así que las páginas cargan un poco más lento y faltan algunas cosas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet fonctionne sur le site mobile d’Instagram : les pages chargent un temps plus lentement et quelques choses manquent."
          }
        },
        "pt-BR": {
