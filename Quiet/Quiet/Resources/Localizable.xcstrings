    "Asking to wait longer takes effect at once. Asking to wait less has to wait — otherwise this would be the one rule you could relax at the moment it started to matter.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Länger warten zu wollen gilt sofort. Weniger warten zu wollen muss warten — sonst wäre das die eine Regel, die du genau in dem Moment lockern könntest, in dem sie anfängt zu wirken."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Asking to wait longer takes effect at once. Asking to wait less has to wait — otherwise this would be the one rule you could relax at the moment it started to matter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedir esperar más tiempo surte efecto de inmediato. Pedir esperar menos tiene que esperar — si no, esta sería la única regla que podrías aflojar justo en el momento en que empieza a importar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander à attendre plus longtemps prend effet tout de suite. Demander à attendre moins doit attendre — sinon ce serait la seule règle que tu pourrais assouplir au moment même où elle commence à compter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedir para esperar mais tempo vale na hora. Pedir para esperar menos tem que esperar — senão essa seria a única regra que você poderia afrouxar no momento exato em que ela começa a pesar."
          }
        }
      }
    },
