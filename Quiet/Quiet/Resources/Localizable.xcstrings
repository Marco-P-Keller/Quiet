    "Try again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch einmal versuchen"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a intentarlo"
          }
        },
        "fr": {
