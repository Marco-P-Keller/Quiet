    "The bar is the shape Instagram uses. The island floats over the page and gets out of the way while you read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leiste ist die Form, die Instagram verwendet. Die Insel schwebt über der Seite und weicht aus, während du liest."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The bar is the shape Instagram uses. The island floats over the page and gets out of the way while you read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra es la forma que usa Instagram. La isla flota sobre la página y se aparta mientras lees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre est la forme qu’utilise Instagram. L’île flotte au-dessus de la page et s’efface pendant que tu lis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra é a forma que o Instagram usa. A ilha flutua sobre a página e sai da frente enquanto você lê."
          }
        }
      }
    },
    "The bar is the shape Instagram uses. The island floats over the page, and draws itself in while the page is moving.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leiste ist die Form, die Instagram benutzt. Die Insel schwebt über der Seite und zieht sich zusammen, während die Seite in Bewegung ist."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The bar is the shape Instagram uses. The island floats over the page, and draws itself in while the page is moving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra es la forma que usa Instagram. La isla flota sobre la página y se recoge mientras la página está en movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre est la forme qu’utilise Instagram. L’île flotte au-dessus de la page et se rétracte pendant que la page bouge."
