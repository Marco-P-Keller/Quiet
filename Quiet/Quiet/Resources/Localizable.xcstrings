    "Less takes effect at once. More starts the next day, and only once a week.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger gilt sofort. Mehr beginnt am nächsten Tag — und nur einmal pro Woche."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Less takes effect at once. More starts the next day, and only once a week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos surte efecto de inmediato. Más empieza al día siguiente, y solo una vez por semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins prend effet tout de suite. Plus commence le lendemain, et seulement une fois par semaine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos vale na hora. Mais começa no dia seguinte, e só uma vez por semana."
