            "value": "A espera entre aumentos"
          }
        }
      }
    },
    "The way out": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ausstieg"
          }
        },
        "en-GB": {
          "stringUnit": {
