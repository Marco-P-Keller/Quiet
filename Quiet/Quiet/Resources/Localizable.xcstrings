        }
      }
    },
    "The dashed line on the chart is your limit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gestrichelte Linie in der Grafik ist dein Limit."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The dashed line on the chart is your limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea discontinua del gráfico es tu límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne pointillée du graphique est ta limite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A linha tracejada do gráfico é o seu limite."
          }
        }
      }
    },
    "The dashed line on the chart is your limit. It is left off when it sits so far above your days that drawing it would flatten them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gestrichelte Linie in der Grafik ist dein Limit. Sie fehlt, wenn sie so weit über deinen Tagen liegt, dass sie diese platt zeichnen würde."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The dashed line on the chart is your limit. It is left off when it sits so far above your days that drawing it would flatten them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea discontinua del gráfico es tu límite. Se omite cuando queda tan por encima de tus días que dibujarla los aplanaría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne pointillée du graphique est ta limite. Elle est omise quand elle se situe si loin au-dessus de tes journées que la tracer les aplatirait."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A linha tracejada do gráfico é o seu limite. Ela fica de fora quando está tão acima dos seus dias que desenhá-la os achataria."
          }
        }
      }
    },
    "The date on this phone is ahead of Instagram's, so Quiet is going by Instagram's. The limit can be lowered, but not raised, until the two agree.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Datum auf diesem Telefon geht Instagram voraus, also richtet Quiet sich nach Instagram. Das Limit kann gesenkt, aber nicht erhöht werden, bis beide übereinstimmen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The date on this phone is ahead of Instagram's, so Quiet is going by Instagram's. The limit can be lowered, but not raised, until the two agree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha de este teléfono va por delante de la de Instagram, así que Quiet se guía por la de Instagram. El límite se puede bajar, pero no subir, hasta que las dos coincidan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date de ce téléphone est en avance sur celle d’Instagram, Quiet s’en tient donc à celle d’Instagram. La limite peut être baissée, mais pas relevée, tant que les deux ne concordent pas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A data deste telefone está à frente da do Instagram, então o Quiet segue a do Instagram. O limite pode ser baixado, mas não aumentado, até que as duas concordem."
          }
        }
      }
    },
    "The date on this phone is ahead of Instagram's. The wait can be made longer, but not shorter, until the two agree.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Datum auf diesem Telefon geht Instagram voraus. Die Wartezeit kann verlängert, aber nicht verkürzt werden, bis beide übereinstimmen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The date on this phone is ahead of Instagram's. The wait can be made longer, but not shorter, until the two agree."
