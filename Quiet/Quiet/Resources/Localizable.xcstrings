    "Months of pages, pictures and answers are kept so the site is quick. Throwing them away costs a slower page or two and does not sign you out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monate an Seiten, Bildern und Antworten werden aufbewahrt, damit die Seite schnell ist. Sie wegzuwerfen kostet ein, zwei langsamere Seiten und meldet dich nicht ab."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Months of pages, pictures and answers are kept so the site is quick. Throwing them away costs a slower page or two and does not sign you out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardan meses de páginas, imágenes y respuestas para que el sitio vaya rápido. Tirarlas cuesta una o dos páginas más lentas y no cierra tu sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des mois de pages, d’images et de réponses sont gardés pour que le site soit rapide. Les jeter coûte une page ou deux plus lentes et ne te déconnecte pas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meses de páginas, imagens e respostas ficam guardados para o site ser rápido. Jogar tudo fora custa uma ou duas páginas mais lentas e não desconecta você."
          }
        }
      }
    },
