          "stringUnit": {
            "state": "translated",
            "value": "La fecha de este teléfono va por detrás de la última que vio Quiet. El límite se puede bajar, pero no subir, hasta que se ponga al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date de ce téléphone est en retard sur la dernière que Quiet a vue. La limite peut être baissée, mais pas relevée, tant qu’elle n’a pas rattrapé."
