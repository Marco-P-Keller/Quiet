        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha de este teléfono va por delante de la de Instagram. La espera se puede alargar, pero no acortar, hasta que las dos coincidan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date de ce téléphone est en avance sur celle d’Instagram. L’attente peut être allongée, mais pas raccourcie, tant que les deux ne concordent pas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A data deste telefone está à frente da do Instagram. A espera pode ser alongada, mas não encurtada, até que as duas concordem."
          }
        }
      }
    },
    "The date on this phone is ahead of Instagram's. Until the two agree, the limit can go down but not up.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Datum auf diesem Telefon geht Instagram voraus. Bis beide übereinstimmen, kann das Limit sinken, aber nicht steigen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The date on this phone is ahead of Instagram's. Until the two agree, the limit can go down but not up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha de este teléfono va por delante de la de Instagram. Hasta que las dos coincidan, el límite puede bajar pero no subir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date de ce téléphone est en avance sur celle d’Instagram. Tant que les deux ne concordent pas, la limite peut descendre mais pas monter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A data deste telefone está à frente da do Instagram. Até que as duas concordem, o limite pode descer mas não subir."
          }
        }
      }
    },
    "The date on this phone is behind where Quiet last saw it. The limit can be lowered, but not raised, until it catches up.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Datum auf diesem Telefon liegt hinter dem, was Quiet zuletzt gesehen hat. Das Limit kann gesenkt werden, aber nicht erhöht, bis es aufgeholt hat."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The date on this phone is behind where Quiet last saw it. The limit can be lowered, but not raised, until it catches up."
          }
        },
