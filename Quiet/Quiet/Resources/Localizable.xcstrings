{
  "sourceLanguage": "en",
  "strings": {
    " It does not give the week back: you can ask for more again %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Die Woche kommt dadurch nicht zurück: um mehr bitten kannst du wieder %@."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": " It does not give the week back: you can ask for more again %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Eso no devuelve la semana: puedes volver a pedir más %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Ça ne rend pas la semaine : tu pourras redemander plus %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Isso não devolve a semana: você pode pedir mais de novo %@."
          }
        }
      }
    },
    " You can ask for more again %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Um mehr kannst du wieder %@ bitten."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": " You can ask for more again %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Puedes volver a pedir más %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Tu pourras redemander plus %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Você pode pedir mais de novo %@."
          }
        }
      }
    },
    " You have already used more than that today, so today ends here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Du hast heute schon mehr verbraucht, also endet der Tag hier."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": " You have already used more than that today, so today ends here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Hoy ya has usado más que eso, así que el día termina aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Tu as déjà utilisé plus que ça aujourd’hui, donc la journée s’arrête ici."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Você já usou mais do que isso hoje, então o dia termina aqui."
          }
        }
      }
    },
    "%@ a day, starting %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ am Tag, ab %@."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a day, starting %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al día, desde %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ par jour, à partir de %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ por dia, a partir de %@."
          }
        }
      }
    },
    "%@ a week fewer than the day you just described.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pro Woche weniger als der Tag, den du gerade beschrieben hast."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a week fewer than the day you just described."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a la semana menos que el día que acabas de describir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de moins par semaine que la journée que tu viens de décrire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ por semana a menos do que o dia que você acabou de descrever."
          }
        }
      }
    },
    "%@ from %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ab %@."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ from %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ desde %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ à partir de %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a partir de %@."
          }
        }
      }
    },
    "%@ is not part of Instagram, so it opened in Safari. If you were signing in, come back and start again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gehört nicht zu Instagram und wurde deshalb in Safari geöffnet. Falls du dich gerade anmelden wolltest: komm zurück und fang noch einmal an."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not part of Instagram, so it opened in Safari. If you were signing in, come back and start again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no forma parte de Instagram, así que se abrió en Safari. Si estabas iniciando sesión, vuelve y empieza de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne fait pas partie d’Instagram, la page s’est donc ouverte dans Safari. Si tu étais en train de te connecter, reviens et recommence."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não faz parte do Instagram, então abriu no Safari. Se você estava entrando na conta, volte e comece de novo."
          }
        }
      }
    },
    "%@ left today.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute noch %@."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ left today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy te queda %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il te reste %@ aujourd’hui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restam %@ hoje."
          }
        }
      }
    },
    "%@ on Instagram over the month — %@ less than those days used to be.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ auf Instagram im Monat — %@ weniger, als diese Tage früher waren."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on Instagram over the month — %@ less than those days used to be."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en Instagram durante el mes — %@ menos de lo que solían ser esos días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sur Instagram sur le mois — %@ de moins que ce qu’étaient ces journées."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no Instagram ao longo do mês — %@ a menos do que esses dias costumavam ser."
          }
        }
      }
    },
