    "Quiet has closed it for the rest of the day: your daily minutes are spent, here and in Quiet together. It opens again at %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet hat sie für den Rest des Tages geschlossen: Deine Tagesminuten sind verbraucht, hier und in Quiet zusammen. Sie öffnet wieder um %@."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet has closed it for the rest of the day: your daily minutes are spent, here and in Quiet together. It opens again at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet la ha cerrado por el resto del día: tus minutos diarios se han acabado, aquí y en Quiet juntos. Vuelve a abrirse a las %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet l’a fermée pour le reste de la journée : tes minutes du jour sont épuisées, ici et dans Quiet ensemble. Elle rouvre à %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Quiet o fechou pelo resto do dia: seus minutos diários acabaram, aqui e no Quiet juntos. Ele abre de novo às %@."
          }
        }
      }
    }
  },
  "version": "1.0"
}
