<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Quiet</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- No cryptography beyond what iOS itself provides for HTTPS. Declaring it
	     here means App Store Connect stops asking at every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The system's own launch, in Quiet's paper rather than in whatever the
	     window happens to start as. It carries no words: the sentence is drawn
	     by the app a frame later, and a launch screen that tried to draw it
	     here would have to be laid out twice, in two different systems, and
	     would still not know the reader's text size. What this buys is that
	     nothing flashes between the two. -->
	<!-- Instagram's own pages carry file inputs: the composer, a profile
	     picture, a photo in a message. When one of them offers the camera, iOS
	     reads these strings out loud — and an app that has not written them is
	     terminated on the spot, with no crash report that names the cause.
	     Quiet does not use the camera itself and never asks for it; these exist
	     so that a tap on somebody else's page cannot end the app. -->
	<key>NSCameraUsageDescription</key>
	<string>Instagram asks for the camera when you add a photo or a story. Quiet never uses it on its own.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Instagram asks for the microphone when you record a video or a voice message. Quiet never uses it on its own.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Instagram asks for your photos when you choose one to post or to send. Quiet never looks at them itself.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Saving a picture from Instagram puts it in your photo library. Quiet adds nothing else.</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>Launch</string>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Portrait only. Instagram's mobile site is a phone layout, and the
	     status-bar gesture that opens the panel assumes the top edge stays put. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
